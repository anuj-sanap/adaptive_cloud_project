# ==============================================================================
# Central Server Configuration
# ==============================================================================
# Host and port to bind (0.0.0.0 binds to all network interfaces for LAN and Internet reachability)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Note: Azure App Service and Container Apps set the PORT environment variable automatically.

# Central Server Authentication Key (Shared Cluster Secret)
# Used to authenticate Node Agents connecting over LAN or Internet.
# In Azure, store this in App Service Configuration (Environment Variables) or Azure Key Vault.
SERVER_API_KEY=your-secure-random-cluster-secret-here

# Persistent SQLite Database Location:
# - Local dev: data/telemetry.db
# - Azure App Service Linux: /home/data/telemetry.db (persisted on /home mount via WEBSITES_ENABLE_APP_SERVICE_STORAGE=true)
# - Azure Container Apps: /app/data/telemetry.db (mounted to Azure Files volume)
TELEMETRY_DB_PATH=data/telemetry.db

# Cross-Origin Resource Sharing (CORS) Allowed Origins:
# Comma-separated list of deployed frontend URLs allowed to access the backend API.
# Azure Static Web Apps subdomains (*.azurestaticapps.net) are matched by default regex.
# Example: https://<your-static-web-app>.azurestaticapps.net,https://custom-domain.com
CORS_ORIGINS=https://<your-app-name>.azurestaticapps.net

# Optional regex for dynamic deployment preview branches
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://.*\.azurestaticapps\.net$

# Seconds before a quiet node is marked OFFLINE (default: 30s)
NODE_OFFLINE_THRESHOLD_SEC=30

# ==============================================================================
# Node Agent Configuration (for connecting edge laptops)
# ==============================================================================
# URL of Central Server (use http:// or https:// with Public IP, Domain, or LAN IP)
NODE_SERVER_URL=http://localhost:8000

# Node Agent API Key (must match SERVER_API_KEY on the central server)
NODE_API_KEY=your-secure-random-cluster-secret-here

# Telemetry interval in seconds (default: 5)
NODE_TELEMETRY_INTERVAL=5

# Heartbeat interval in seconds (default: 15)
NODE_HEARTBEAT_INTERVAL=15

# Request timeout in seconds
NODE_HTTP_TIMEOUT=10.0

# Verify SSL certificates when connecting to https:// (set to false only for self-signed testing)
NODE_SSL_VERIFY=true

# Maximum number of offline telemetry snapshots to buffer during temporary network drops
NODE_BUFFER_MAX=120
